# =============================================================================
# DocuRisk AI — Unified Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js 16)
# Location: frontend/.env.local
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME="DocuRisk AI"
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# -----------------------------------------------------------------------------
# 2. Backend Configuration (Java Spring Boot)
# Location: backend/src/main/resources/application.properties or environment
# -----------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/docurisk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=docurisk_user
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update
AI_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 3. Database Configuration (MySQL 8.0)
# Location: database/docker-compose.yml or local MySQL instance
# -----------------------------------------------------------------------------
MYSQL_DATABASE=docurisk_db
MYSQL_USER=docurisk_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# 4. AI Service Configuration (Python FastAPI)
# Location: ai-service/.env
# -----------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_DEBUG=true
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=default
